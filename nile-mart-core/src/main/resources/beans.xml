<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- XML equivalent of ObjectFactory.createShippingQuoteService(). -->
    <bean id="zoneShipping" class="org.route.shipping.ZoneShippingCalculator"/>

    <bean id="freeShipping" class="org.route.shipping.FreeShippingCalculator"/>

    <bean id="shippingQuoteService" class="org.route.shipping.ShippingQuoteService">
        <constructor-arg ref="zoneShipping"/>
        <constructor-arg ref="freeShipping"/>
        <constructor-arg value="5000.00"/>
    </bean>
</beans>
